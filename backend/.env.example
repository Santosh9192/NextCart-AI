# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextcart_ai

# JWT settings
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: comma-separated list, or * to allow all
CORS_ORIGINS=*

# Directory where product image uploads are stored
UPLOAD_DIR=uploads

# Set to false to skip seeding demo customers + orders (kept true by default)
SEED_DEMO_DATA=true
